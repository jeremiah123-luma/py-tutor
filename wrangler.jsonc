{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "py-tutor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "KV", "id": "da669864bff842b6a4874b89741d2788" }],
  "vars": { "MONTHLY_BUDGET_USD": "30", "ADMIN_EMAIL": "jms423@njit.edu" },
  "observability": { "enabled": true }
}
